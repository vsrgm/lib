              <layout class="QHBoxLayout" name="hboxBuzzerFreq">
               <item><widget class="QLabel" name="lblBuzzerFreq"><property name="text"><string>Buzzer Freq (Hz):</string></property></widget></item>
               <item><widget class="QSlider" name="sliderStudyBuzzerFreq"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>500</number></property><property name="maximum"><number>5000</number></property><property name="value"><number>2000</number></property></widget></item>
               <item><widget class="QLabel" name="lblStudyBuzzerFreqVal"><property name="text"><string>2000 Hz</string></property></widget></item>
              </layout>
             </item>
             <item><widget class="QCheckBox" name="chkStudyIrRecv"><property name="text"><string>IR Receive Mode</string></property></widget></item>
