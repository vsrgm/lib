<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/colorBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="@string/content_desc_back"
            app:tint="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/title_kitchen_exhaust"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="?android:attr/textColorPrimary" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/card_ip_sync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected Nodes"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/node_selector"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/available_nodes_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" (Searching...)"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/sync_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Last Sync: Never"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:id="@+id/status_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include android:id="@+id/row_fan_status" layout="@layout/item_status_row" />
            <include android:id="@+id/row_buzzer_status" layout="@layout/item_status_row" />
            <include android:id="@+id/row_mq2_a" layout="@layout/item_status_row" />
            <include android:id="@+id/row_mq2_d" layout="@layout/item_status_row" />
            <include android:id="@+id/row_ldr_status" layout="@layout/item_status_row" />
            <include android:id="@+id/row_user_switch" layout="@layout/item_status_row" />
            <include android:id="@+id/row_manual" layout="@layout/item_status_row" />
            <include android:id="@+id/row_timestamp" layout="@layout/item_status_row" />

            <!-- Configuration Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Threshold Configuration"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0D000000"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Smoke ON Threshold"/>
                    <EditText android:id="@+id/et_smoke_on" android:layout_width="80dp" android:layout_height="wrap_content" android:inputType="number" android:hint="450" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Smoke OFF Threshold"/>
                    <EditText android:id="@+id/et_smoke_off" android:layout_width="80dp" android:layout_height="wrap_content" android:inputType="number" android:hint="350" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Buzzer Threshold"/>
                    <EditText android:id="@+id/et_buzzer_th" android:layout_width="80dp" android:layout_height="wrap_content" android:inputType="number" android:hint="600" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Buzzer Frequency (Hz)"/>
                    <EditText android:id="@+id/et_buzzer_freq" android:layout_width="80dp" android:layout_height="wrap_content" android:inputType="number" android:hint="2000" android:textSize="14sp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_update_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apply Configuration"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btn_sync"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sync Data"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_sync_history"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sync History" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Connection Logs"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"/>

            <ScrollView
                android:id="@+id/log_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#1A000000"
                android:padding="8dp">
                <TextView
                    android:id="@+id/tv_connection_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </ScrollView>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/history_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/history_expand"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:id="@+id/history_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TableLayout
                    android:id="@+id/history_table"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TableRow android:background="#444">
                        <TextView android:text="Date" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                        <TextView android:text="Time" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                        <TextView android:text="Event" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                        <TextView android:text="Fan" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                        <TextView android:text="Manual" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                        <TextView android:text="MQ2" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                        <TextView android:text="LDR" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                    </TableRow>
                </TableLayout>

                <Button
                    android:id="@+id/btn_clear_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="Clear Device History"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
            </LinearLayout>
        </ScrollView>
    </HorizontalScrollView>

</LinearLayout>
