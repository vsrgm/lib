  </property>
  <property name="windowTitle">
   <string>IoT Home Control Center (Qt x86 Desktop)</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: #1e1e2f; color: #ffffff; }
QTabWidget::pane { border: 1px solid #33334d; background: #252538; }
QTabBar::tab { background: #1a1a28; color: #aaa; padding: 8px 16px; margin: 2px; border-radius: 4px; }
QTabBar::tab:selected { background: #3d5afe; color: #fff; font-weight: bold; }
QGroupBox { font-weight: bold; border: 1px solid #3d3d5c; border-radius: 6px; margin-top: 12px; padding-top: 10px; color: #3d5afe; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 5px; }
QLabel { color: #e0e0e0; }
QPushButton { background-color: #3d5afe; color: white; border: none; border-radius: 4px; padding: 6px 12px; font-weight: bold; }
QPushButton:hover { background-color: #536dfe; }
QPushButton:pressed { background-color: #304ffe; }
QLineEdit, QSpinBox, QComboBox { background-color: #1a1a28; border: 1px solid #3d3d5c; border-radius: 4px; color: #fff; padding: 4px; }
QTableWidget { background-color: #1a1a28; color: #fff; gridline-color: #3d3d5c; border: 1px solid #3d3d5c; }
QHeaderView::section { background-color: #252538; color: #888; border: 1px solid #3d3d5c; }
QTextEdit { background-color: #12121c; color: #00ff66; font-family: monospace; border: 1px solid #3d3d5c; }</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayoutMain">
