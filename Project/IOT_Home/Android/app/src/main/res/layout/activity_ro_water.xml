<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/colorBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="@string/content_desc_back"
            app:tint="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/title_ro_pump"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="?android:attr/textColorPrimary" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/card_ip_sync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected Nodes"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/node_selector"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/available_nodes_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" (Searching...)"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/sync_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Last Sync: Never"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:id="@+id/status_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include android:id="@+id/row_pump_status" layout="@layout/item_status_row" />
            <include android:id="@+id/row_water_level" layout="@layout/item_status_row" />
            <include android:id="@+id/row_manual" layout="@layout/item_status_row" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btn_sync"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sync Data"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_sync_history"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sync History" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Connection Logs"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"/>

            <ScrollView
                android:id="@+id/log_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#1A000000"
                android:padding="8dp">
                <TextView
                    android:id="@+id/tv_connection_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </ScrollView>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/history_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/history_expand"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:id="@+id/history_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TableLayout
                android:id="@+id/history_table"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp">
                <TableRow android:background="#444">
                    <TextView android:text="Date" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                    <TextView android:text="Time" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                    <TextView android:text="Event" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                    <TextView android:text="Pump" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                    <TextView android:text="Level" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                    <TextView android:text="Manual" android:textColor="#FFF" android:padding="8dp" android:textStyle="bold"/>
                </TableRow>
            </TableLayout>

            <Button
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="Clear Device History"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
