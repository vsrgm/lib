             <item row="5" column="0"><widget class="QLabel" name="lblStudyLastSyncTitle"><property name="text"><string>Last Synced:</string></property></widget></item>
             <item row="5" column="1"><widget class="QLabel" name="lblStudyLastSync"><property name="text"><string>Never</string></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grpStudyControls">
            <property name="title"><string>Controls</string></property>
            <layout class="QVBoxLayout" name="vboxStudyControls">
             <item><widget class="QCheckBox" name="chkStudyOverride"><property name="text"><string>Manual Override</string></property></widget></item>
             <item><widget class="QCheckBox" name="chkStudyLight"><property name="text"><string>Emergency Light</string></property></widget></item>
             <item><widget class="QCheckBox" name="chkStudyBuzzer"><property name="text"><string>Study Buzzer</string></property></widget></item>
