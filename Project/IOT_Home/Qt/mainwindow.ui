      <!-- TAB 4: Kitchen Exhaust Fan -->
      <widget class="QWidget" name="tabExhaust">
       <attribute name="title"><string>Kitchen Exhaust Fan</string></attribute>
       <layout class="QHBoxLayout" name="hboxExhaust">
        <item>
         <layout class="QVBoxLayout" name="vboxExhaustLeft">
          <item>
           <widget class="QGroupBox" name="grpExhaustStatus"><property name="title"><string>Exhaust &amp; Smoke Telemetry</string></property>
            <layout class="QFormLayout" name="formExhaustSensors">
             <item row="0" column="0"><widget class="QLabel" name="ex1"><property name="text"><string>MQ2 Smoke Analog:</string></property></widget></item>
